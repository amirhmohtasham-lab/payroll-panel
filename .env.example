# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8765
APP_SECRET_KEY=change-me-generate-a-random-64-char-hex-string

# --- Database ---
DATABASE_URL=postgresql+psycopg://payroll:payroll@db:5432/payroll_panel

# --- Auth ---
SESSION_COOKIE_NAME=payroll_session
SESSION_TTL_HOURS=168
ACCESS_TOKEN_TTL_HOURS=24

# --- Storage ---
UPLOAD_DIR=/data/uploads
DATA_DIR=/data/app-data

# --- Google Drive backup ---
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-service-account.json
DRIVE_PARENT_FOLDER_ID=
DRIVE_FOLDER_NAME=صورت-کارگری-پنل-بهزادیان

# --- CORS (comma-separated origins, blank = same-origin only) ---
CORS_ORIGINS=
